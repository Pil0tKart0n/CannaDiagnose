# LeafScan / CannaDiagnose - Server Environment Variables
# Copy to .env.server and fill in real values
# NEVER commit the real .env.server file!

# OpenAI API Key (for GPT-4o diagnosis)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Tester Key (bypasses rate limiting for QA)
TESTER_KEY=your-tester-key-here

# Admin Key (admin dashboard access)
ADMIN_KEY=your-admin-key-here

# Domain (for Stripe redirect URLs)
DOMAIN=https://leafscan.de

# Server Port (default: 4000)
PORT=4000
